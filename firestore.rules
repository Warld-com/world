rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic helpers
    function isSignedIn() { return request.auth != null; }
    
    // Admin list
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'ZPHYftpJzjhllADJsPkCnq4wHm93' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'mdtuhinhosinn373@gmail.com') ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'mdtuhinhosinn@gmail.com') ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'warld.com1996@gmail.com') ||
        request.auth.token.get('email', '').lower() == 'mdtuhinhosinn373@gmail.com' ||
        request.auth.token.get('email', '').lower() == 'mdtuhinhosinn@gmail.com' ||
        request.auth.token.get('email', '').lower() == 'warld.com1996@gmail.com'
      );
    }

    // Ownership helper
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Document ownership check (for delete/update)
    function isDocOwner() {
      return isSignedIn() && resource != null && (
        (resource.data.get('userId', '') != '' && resource.data.get('userId', '') == request.auth.uid) ||
        (resource.data.get('authorId', '') != '' && resource.data.get('authorId', '') == request.auth.uid) ||
        (resource.data.get('creatorId', '') != '' && resource.data.get('creatorId', '') == request.auth.uid)
      );
    }

    // Default: Allow full access to admins
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
      
      // All user subcollections: notifications, followers, following, savedPosts, blockedUsers, notInterested, sessions
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isSignedIn() || isAdmin();
      }
    }

    // Videos/Posts Collection
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update: if (
        isAdmin() || 
        isDocOwner() || 
        (isSignedIn() && request.auth.uid == request.resource.data.get('userId', '')) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount', 'views', 'viewsCount', 'shares', 'shareCount', 'repostCount', 'reaction'])
      );
      allow delete: if isAdmin() || isDocOwner() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
      
      // Video subcollections: likes, comments, etc.
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isSignedIn() || isAdmin();
      }
    }

    // Stories Collection
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update: if (
        isAdmin() || 
        isDocOwner() || 
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'views', 'viewsCount']))
      );
      allow delete: if isAdmin() || isDocOwner() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isSignedIn() || isAdmin();
      }
    }

    // Internal Docs (connectivity checks, app updates, pings)
    match /_internal/{docId} {
      allow read, write: if true;
    }

    // Music Collection
    match /music/{musicId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update: if isAdmin() || (isSignedIn() && (resource.data.get('creatorId', '') == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount'])));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.get('creatorId', '') == request.auth.uid);
    }

    // Direct Messages Collection
    match /direct_messages/{messageId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants || isAdmin());
      allow update: if isAdmin() || (isSignedIn() && (request.auth.uid in resource.data.participants));
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.senderId == request.auth.uid || request.auth.uid in resource.data.participants));
    }

    // Reports Collection
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Copyright Claims Collection
    match /copyrightClaims/{claimId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Products (Marketplace) Collection
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
    }
  }
}
